FROM debian:bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang flex bison g++ gawk gcc-multilib g++-multilib \
    gettext git libncurses-dev libssl-dev python3 python3-setuptools \
    rsync unzip wget zlib1g-dev file ca-certificates xz-utils zstd patch \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m builder && mkdir /src && chown builder:builder /src
USER builder
WORKDIR /src
ENTRYPOINT ["bash", "/work/scripts/build_flash_image.sh"]
